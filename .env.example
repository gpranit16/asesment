# ==============================================================================
# Enterprise Multi-Agent AI System - Environment Configuration
# ==============================================================================

# LLM Providers (Choose one or provide multiple)
# Groq is 100% free and lightning-fast (Recommended by the assessment)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: OpenAI (e.g. gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional alternative: Google Gemini API (Free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Active Provider: "auto" (prioritizes Groq -> OpenAI -> Gemini), or "groq", "openai"
LLM_PROVIDER=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000
VITE_API_BASE_URL=http://localhost:8000
